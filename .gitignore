# Dependencies
node_modules
.pnpm-store

# Build output
dist
dist-ssr
*.local

# Tauri / Rust
src-tauri/target
src-tauri/gen

# Bundled third-party binaries (provided per-platform, see README)
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep
src-tauri/share/*
!src-tauri/share/.gitkeep
src-tauri/tesseract/*
!src-tauri/tesseract/.gitkeep
src-tauri/libreoffice/*
!src-tauri/libreoffice/.gitkeep
src-tauri/windows-runtime/*
!src-tauri/windows-runtime/.gitkeep

# Editor / OS
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json
*.log
.env
.env.*

# Signing material must never be committed
*.p12
AuthKey_*.p8
*.certSigningRequest
